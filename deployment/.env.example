# SomaAI Production Environment Variables Example
# Copy this file to .env and update the values.

# --- Application ---
SOMAAI_APP_NAME=SomaAI
SOMAAI_VERSION=0.1.0
SOMAAI_DEBUG=false
SOMAAI_HOST=0.0.0.0
SOMAAI_PORT=8000
# List of allowed origins for CORS. Use ["*"] for dev-only, restricted list for prod.
SOMAAI_CORS_ALLOWED_ORIGINS=["https://app.somaai.rw", "http://localhost:3000"]

# --- Security ---
# Enable API Key requirement for all endpoints in production
SOMAAI_REQUIRE_API_KEY=true
# Secret for internal service communication if needed
# SOMAAI_SECRET_KEY=yoursecretkeyhere

# --- Database (PostgreSQL) ---
# Format: postgresql+asyncpg://user:password@host:port/dbname
SOMAAI_DATABASE_URL=postgresql+asyncpg://somaai_user:somaai_password@db:5432/somaai
POSTGRES_USER=somaai_user
POSTGRES_PASSWORD=somaai_password
POSTGRES_DB=somaai

# --- Redis & Cache ---
# Primary Redis for rate limiting and general caching
SOMAAI_REDIS_URL=redis://redis:6379/0
# Redis DB 1 for background job queue (ARQ)
SOMAAI_REDIS_JOBS_URL=redis://redis:6379/1
# Redis DB 2 for specific metadata/embedding caching
SOMAAI_REDIS_CACHE_URL=redis://redis:6379/2
# REDIS_PASSWORD=

# --- Vector Database (Qdrant) ---
SOMAAI_QDRANT_URL=http://qdrant:6333
# SOMAAI_QDRANT_API_KEY=
SOMAAI_QDRANT_COLLECTION_NAME=somaai_documents

# --- Storage ---
SOMAAI_STORAGE_BACKEND=minio # Change to 's3' for AWS/DigitalOcean
# Minio configuration (Self-hosted)
SOMAAI_MINIO_ENDPOINT=minio:9000
SOMAAI_MINIO_ACCESS_KEY=minioadmin
SOMAAI_MINIO_SECRET_KEY=minioadmin
SOMAAI_MINIO_BUCKET=somaai-documents
SOMAAI_MINIO_SECURE=false

# AWS S3 Configuration (if storage_backend=s3)
# SOMAAI_S3_BUCKET=somaai-prod-assets
# SOMAAI_S3_REGION=us-east-1
# SOMAAI_S3_ACCESS_KEY=AKIA...
# SOMAAI_S3_SECRET_KEY=...
# SOMAAI_S3_ENDPOINT_URL=https://s3.amazonaws.com

# --- LLM Backend (Groq recommended for speed) ---
SOMAAI_LLM_BACKEND=groq
SOMAAI_GROQ_API_KEY=your_groq_api_key_here
SOMAAI_GROQ_MODEL=llama3.2
# SOMAAI_OPENAI_API_KEY=
# SOMAAI_OPENAI_MODEL=gpt-4o
# SOMAAI_HUGGINGFACE_API_KEY=

# --- Monitoring ---
SOMAAI_ENABLE_METRICS=true
# SOMAAI_LOG_LEVEL=INFO
