# SomaAI Environment Configuration Example
# Copy this to .env and fill in the values

# --- Application ---
APP_NAME=SomaAI
VERSION=0.1.0
DEBUG=true
PORT=8000
REQUIRE_API_KEY=false

# --- Database (PostgreSQL) ---
# For local dev with docker-compose:
# DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/somaai
# For testing:
DATABASE_URL=sqlite+aiosqlite:///./somaai.db

# --- Redis / Cache ---
REDIS_URL=redis://localhost:6379/0
REDIS_JOBS_URL=redis://localhost:6379/1
REDIS_CACHE_URL=redis://localhost:6379/2
# REDIS_PASSWORD=your_password

# --- Vector Database (Qdrant) ---
QDRANT_URL=http://localhost:6333
# QDRANT_API_KEY=your_key
QDRANT_COLLECTION_NAME=somaai_documents

# --- Storage (MinIO or S3) ---
STORAGE_BACKEND=minio  # minio | s3

# MinIO (Local Dev)
MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=somaai-documents
MINIO_SECURE=false

# S3 (Production - Required if STORAGE_BACKEND=s3)
# S3_BUCKET=your-bucket
# S3_REGION=us-east-1
# S3_ACCESS_KEY=your_access_key
# S3_SECRET_KEY=your_secret_key

# --- LLM Backend ---
LLM_BACKEND=groq  # groq | openai | huggingface | mock
GROQ_API_KEY=gsk_...
GROQ_MODEL=llama3.2

# OPENAI_API_KEY=sk-...
# OPENAI_MODEL=gpt-4o-mini

# HUGGINGFACE_API_KEY=hf_...
