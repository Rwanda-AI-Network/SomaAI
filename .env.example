# Application Settings
APP_NAME=SomaAI
VERSION=0.1.0
DEBUG=false
HOST=0.0.0.0
PORT=8000

# Database
# Use postgresql+asyncpg for production
DATABASE_URL=postgresql+asyncpg://somaai:somaai@localhost:5432/somaai

# Redis / Cache
REDIS_URL=redis://localhost:6379/0
REDIS_JOBS_URL=redis://localhost:6379/1
REDIS_CACHE_URL=redis://localhost:6379/2
# REDIS_PASSWORD=secret
RESPONSE_CACHE_MIN_CONFIDENCE=0.7

# Vector Database (Qdrant)
QDRANT_URL=http://localhost:6333
# QDRANT_API_KEY=secret
QDRANT_COLLECTION_NAME=somaai_documents

# Storage (Object Storage)
STORAGE_BACKEND=minio  # minio (dev) | s3 (prod)

# MinIO (Development)
MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=somaai-documents
MINIO_SECURE=false

# S3 (Production) — uncomment when deploying to AWS
# STORAGE_BACKEND=s3
# S3_BUCKET=somaai-documents-prod
# S3_REGION=us-east-1
# S3_ACCESS_KEY=
# S3_SECRET_KEY=
# S3_ENDPOINT_URL=  # leave empty for real AWS S3

# Background Jobs
QUEUE_BACKEND=redis

# LLM Provider Configuration
# Options: mock, groq, openai, huggingface
LLM_BACKEND=mock

# Groq
GROQ_API_KEY=gsk_...
GROQ_MODEL=""

# OpenAI
# OPENAI_API_KEY=sk-...
# OPENAI_MODEL=gpt-4-turbo

# HuggingFace
# HUGGINGFACE_API_KEY=hf_...
# HUGGINGFACE_MODEL=meta-llama/Llama-2-7b-chat-hf

# Security
REQUIRE_API_KEY=false

# RAG Configuration
RAG_ENABLE_HYDE=false
RAG_ENABLE_RERANKING=false
RAG_ENABLE_INPUT_VALIDATION=true
RAG_USE_SIMPLIFIED_RETRIEVAL=true

# Hybrid Search (BM25 + Dense Vector)
RAG_ENABLE_HYBRID_SEARCH=false  # Enable hybrid search for better keyword matching
RAG_HYBRID_ALPHA=0.5  # Balance between sparse (0) and dense (1) retrieval
RAG_BM25_K1=1.5  # BM25 term frequency saturation
RAG_BM25_B=0.75  # BM25 document length normalization
