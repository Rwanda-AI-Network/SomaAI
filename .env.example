# SomaAI Environment Configuration
# Copy this to .env and fill in the values

# --- Application ---
SOMAAI_ENV=dev
SOMAAI_SERVER__DEBUG=true
SOMAAI_SERVER__HOST=0.0.0.0
SOMAAI_SERVER__PORT=8000
SOMAAI_SERVER__QUEUE_BACKEND=redis  # "redis" for production, "sync" for testing
SOMAAI_SECURITY__REQUIRE_API_KEY=false

# --- Database (PostgreSQL) ---
# Format: postgresql+asyncpg://user:pass@host:port/dbname
# Local dev with docker-compose:
# SOMAAI_DB__URL=postgresql+asyncpg://somaai:somaai@localhost:5432/somaai
# Local dev with SQLite:
SOMAAI_DB__URL=sqlite+aiosqlite:///./somaai.db
SOMAAI_DB__POOL_SIZE=10
SOMAAI_DB__MAX_OVERFLOW=20

# --- Redis (Caching & Task Queue) ---
SOMAAI_REDIS__URL=redis://localhost:6379/0
SOMAAI_REDIS__JOBS_URL=redis://localhost:6379/1
SOMAAI_REDIS__CACHE_URL=redis://localhost:6379/2
# SOMAAI_REDIS__PASSWORD=

# --- Vector Database (Qdrant) ---
SOMAAI_QDRANT__URL=http://localhost:6333
# SOMAAI_QDRANT__API_KEY=your_key_here
SOMAAI_QDRANT__COLLECTION_NAME=somaai_documents

# --- Object Storage (MinIO / S3) ---
SOMAAI_STORAGE__BACKEND=minio
SOMAAI_STORAGE__MINIO_ENDPOINT=localhost:9000
SOMAAI_STORAGE__MINIO_ACCESS_KEY=minioadmin
SOMAAI_STORAGE__MINIO_SECRET_KEY=minioadmin
SOMAAI_STORAGE__MINIO_BUCKET=somaai-documents
SOMAAI_STORAGE__MINIO_SECURE=false

# PROD S3 (Required if STORAGE_BACKEND=s3)
# SOMAAI_STORAGE__S3_BUCKET=
# SOMAAI_STORAGE__S3_REGION=us-east-1
# SOMAAI_STORAGE__S3_ACCESS_KEY=
# SOMAAI_STORAGE__S3_SECRET_KEY=

# --- LLM Backends ---
SOMAAI_LLM__BACKEND=groq

# Groq (Default)
# SOMAAI_LLM__GROQ_API_KEY=your_groq_key_here
SOMAAI_LLM__GROQ_MODEL=llama3.2

# OpenAI (Optional)
# SOMAAI_LLM__OPENAI_API_KEY=
# SOMAAI_LLM__OPENAI_MODEL=gpt-4o-mini

# --- Monitoring ---
# Enable/Disable Prometheus metrics collection and the /metrics endpoint.
# Defaults to true.
SOMAAI_ENABLE_METRICS=true