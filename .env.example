# SomaAI Environment Configuration
# Copy this to .env and fill in the values.
# List values use JSON array format: ["value1", "value2"]

# --- Application ---
SOMAAI_ENV=dev
SOMAAI_APP_NAME=SomaAI
SOMAAI_DEBUG=true
SOMAAI_HOST=0.0.0.0
SOMAAI_PORT=8000

# --- Security ---
# Disable API key enforcement for local development
SOMAAI_REQUIRE_API_KEY=false
# API keys (JSON array). Enable REQUIRE_API_KEY and add keys for production.
# SOMAAI_API_KEYS=["your-secure-key-here"]

# --- CORS ---
# Use ["*"] for local dev, restrict to your domain(s) in production.
SOMAAI_CORS_ALLOWED_ORIGINS=["*"]
SOMAAI_CORS_ALLOW_CREDENTIALS=true

# --- Session ---
SOMAAI_SESSION_COOKIE_SECURE=false
SOMAAI_SESSION_TTL_DAYS=90

# --- Database (PostgreSQL) ---
# Format: postgresql+asyncpg://user:pass@host:port/dbname
# Local dev with SQLite:
SOMAAI_DATABASE_URL=sqlite+aiosqlite:///./somaai.db
# Local dev with Docker Compose:
# SOMAAI_DATABASE_URL=postgresql+asyncpg://somaai:somaai@localhost:5432/somaai
SOMAAI_DB_POOL_SIZE=10
SOMAAI_DB_MAX_OVERFLOW=20
SOMAAI_DB_ECHO_SQL=false

# --- Redis (Caching & Task Queue) ---
SOMAAI_REDIS_URL=redis://localhost:6379/0
SOMAAI_REDIS_JOBS_URL=redis://localhost:6379/1
SOMAAI_REDIS_CACHE_URL=redis://localhost:6379/2
# SOMAAI_REDIS_PASSWORD=

# --- Vector Database (Qdrant) ---
SOMAAI_QDRANT_URL=http://localhost:6333
# SOMAAI_QDRANT_API_KEY=
SOMAAI_QDRANT_COLLECTION=somaai_documents

# --- Object Storage (MinIO / S3) ---
SOMAAI_STORAGE_BACKEND=minio
SOMAAI_MINIO_ENDPOINT=localhost:9000
# IMPORTANT: In production, do NOT use 'minioadmin'
SOMAAI_MINIO_ACCESS_KEY=somaai_admin
SOMAAI_MINIO_SECRET_KEY=somaai_secure_pass_2026
SOMAAI_MINIO_BUCKET=somaai-documents
SOMAAI_MINIO_SECURE=false

# Root credentials for MinIO container (matches above)
MINIO_ROOT_USER=somaai_admin
MINIO_ROOT_PASSWORD=somaai_secure_pass_2026

# AWS S3 Configuration (if storage_backend=s3)
# SOMAAI_S3_BUCKET=somaai-prod-assets
# SOMAAI_S3_REGION=us-east-1
# SOMAAI_S3_ACCESS_KEY=AKIA...
# SOMAAI_S3_SECRET_KEY=...
# SOMAAI_S3_ENDPOINT_URL=https://s3.amazonaws.com

# --- LLM Backends ---
SOMAAI_LLM_BACKEND=groq
SOMAAI_GROQ_API_KEY=your_groq_key_here
SOMAAI_GROQ_MODEL=llama-3.3-70b-versatile

# Gemini (Optional)
# SOMAAI_GEMINI_API_KEY=
# SOMAAI_GEMINI_MODEL=gemini-1.5-flash

# OpenAI (Optional)
# SOMAAI_OPENAI_API_KEY=
# SOMAAI_OPENAI_MODEL=gpt-4o-mini

# --- Advanced RAG & Cache ---
SOMAAI_RAG_ENABLE_HYBRID_SEARCH=true
SOMAAI_RAG_ENABLE_INPUT_VALIDATION=true
SOMAAI_CACHE_SEMANTIC_ENABLED=true
SOMAAI_CACHE_SIMILARITY_THRESHOLD=0.92

# --- Monitoring ---
SOMAAI_ENABLE_METRICS=true
# SOMAAI_LOG_LEVEL=INFO