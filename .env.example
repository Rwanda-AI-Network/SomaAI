# ── SomaAI Environment Configuration
# Copy to .env and fill in your values.

#Core
SOMAAI_ENV=dev
SOMAAI_DEBUG=true
SOMAAI_HOST=0.0.0.0
SOMAAI_PORT=8000
SOMAAI_REQUIRE_API_KEY=false

# Database
# Dev (SQLite — no setup needed):
SOMAAI_DATABASE_URL=sqlite+aiosqlite:///./somaai.db
# Prod (PostgreSQL):
SOMAAI_DATABASE_URL=postgresql+asyncpg://somaai:somaai@localhost:5432/somaai
SOMAAI_DB_POOL_SIZE=10
SOMAAI_DB_MAX_OVERFLOW=20

# ── Redis
SOMAAI_REDIS_URL=redis://localhost:6379/0
SOMAAI_REDIS_JOBS_URL=redis://localhost:6379/1
SOMAAI_REDIS_CACHE_URL=redis://localhost:6379/2
# SOMAAI_REDIS_PASSWORD=

# ── Qdrant
SOMAAI_QDRANT_URL=http://localhost:6333
# SOMAAI_QDRANT_API_KEY=
SOMAAI_QDRANT_COLLECTION=somaai_documents

# ── Storage (MinIO) 
SOMAAI_STORAGE_BACKEND=minio
SOMAAI_MINIO_ENDPOINT=localhost:9000
SOMAAI_MINIO_ACCESS_KEY=minioadmin
SOMAAI_MINIO_SECRET_KEY=minioadmin
SOMAAI_MINIO_BUCKET=somaai-documents
SOMAAI_MINIO_SECURE=false

# ── LLM
SOMAAI_LLM_BACKEND=groq
# SOMAAI_GROQ_API_KEY=gsk_your_key_here
SOMAAI_GROQ_MODEL=llama-3.3-70b-versatile


# ── Monitoring
SOMAAI_ENABLE_METRICS=true